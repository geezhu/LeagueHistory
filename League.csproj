<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<ApplicationIcon>favicon.ico</ApplicationIcon>
		<ApplicationManifest>app.manifest</ApplicationManifest>
	</PropertyGroup>
	<ItemGroup>
	  <AdditionalFiles Remove="app.manifest" />
	  <Compile Remove="Tests\**\*.cs" />
	</ItemGroup>

	<ItemGroup>
	  <Content Include="favicon.ico" />
	  <EmbeddedResource Include="Assets\WeGame\honor16.png" LogicalName="League.WeGame.honor16.png" />
	  <EmbeddedResource Include="Assets\WeGame\team-*.png" LogicalName="League.WeGame.%(Filename)%(Extension)" />
	  <EmbeddedResource Include="Assets\Ranked\*.png" />
	  <EmbeddedResource Include="Scripts\ShutdownAfterLoL.ps1" LogicalName="League.ScheduledShutdown.ps1" />
	  <EmbeddedResource Include="Assets\Maps\*.png" />
	  <EmbeddedResource Include="Assets\ChampionClasses\*.png" />
	  <None Update="Assets\Defaults\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	  <None Update="Assets\ThirdParty\*.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
		<PackageReference Include="NVorbis" Version="0.10.5" />
		<PackageReference Include="System.Management" Version="9.0.4" />
		<!-- XXH3 for the game string table keys the augment descriptions are filed under. -->
		<PackageReference Include="System.IO.Hashing" Version="9.0.4" />
		<PackageReference Include="System.Speech" Version="9.0.4" />
		<PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
		<PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-x64" Version="1.13.8" />
		<!-- Download only the managed binding; its meta-package otherwise restores every OS runtime. -->
		<PackageDownload Include="org.k2fsa.sherpa.onnx" Version="[1.13.8]" />
		<Reference Include="sherpa-onnx">
			<HintPath>$(NuGetPackageRoot)org.k2fsa.sherpa.onnx/1.13.8/lib/net8.0/sherpa-onnx.dll</HintPath>
			<Private>true</Private>
		</Reference>
	</ItemGroup>
	<!-- Release packages pass -p:BundleVoiceModel=false; users download the model in Settings instead. -->
	<ItemGroup Condition="'$(BundleVoiceModel)' != 'false' And Exists('bin/VoiceModels/SenseVoice/model.int8.onnx')">
		<Content Include="bin/VoiceModels/SenseVoice/model.int8.onnx;bin/VoiceModels/SenseVoice/tokens.txt;bin/VoiceModels/SenseVoice/LICENSE">
			<Link>VoiceModels/SenseVoice/%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
	</ItemGroup>

	<!-- The component GameBar/Build.ps1 last built, beside League.exe where Settings looks for the bundled version;
	     without it a development build keeps offering whatever package was copied there by hand. Release packages
	     build and add a fresh one in Scripts/Publish-Release.ps1, so publishing never takes this copy. -->
	<ItemGroup Condition="Exists('bin/GameBar/LeagueHistory.GameBar.msix')">
		<Content Include="bin/GameBar/LeagueHistory.GameBar.msix">
			<Link>GameBar/LeagueHistory.GameBar.msix</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>Never</CopyToPublishDirectory>
		</Content>
	</ItemGroup>

	<!-- 资源文件配置（保持不变） -->
	<ItemGroup>
		<Compile Update="Properties\Resources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
		<Compile Update="Properties\Settings.Designer.cs">
		  <DesignTimeSharedInput>True</DesignTimeSharedInput>
		  <AutoGen>True</AutoGen>
		  <DependentUpon>Settings.settings</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Properties\Resources.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="image\" />
	</ItemGroup>

	<ItemGroup>
	  <None Update="Properties\Settings.settings">
	    <Generator>SettingsSingleFileGenerator</Generator>
	    <LastGenOutput>Settings.Designer.cs</LastGenOutput>
	  </None>
	</ItemGroup>

	<!-- The SDK already appends the commit to the product version. Record whether the working tree had
	     uncommitted changes and when it was built, so Settings and diagnostic reports can show the exact source.
	     Without git (e.g. building from a source archive) the state stays "unknown". -->
	<Target Name="AddSourceStateMetadata" BeforeTargets="GetAssemblyAttributes">
		<Exec Command="git status --porcelain" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true"
		      StandardOutputImportance="low" StandardErrorImportance="low" IgnoreExitCode="true"
		      Condition="Exists('$(MSBuildProjectDirectory)\.git')">
			<Output TaskParameter="ConsoleOutput" PropertyName="SourceStatusOutput" />
			<Output TaskParameter="ExitCode" PropertyName="SourceStatusExitCode" />
		</Exec>
		<PropertyGroup>
			<SourceDirty>unknown</SourceDirty>
			<SourceDirty Condition="'$(SourceStatusExitCode)' == '0' And '$(SourceStatusOutput)' == ''">false</SourceDirty>
			<SourceDirty Condition="'$(SourceStatusExitCode)' == '0' And '$(SourceStatusOutput)' != ''">true</SourceDirty>
		</PropertyGroup>
		<ItemGroup>
			<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
				<_Parameter1>SourceDirty</_Parameter1>
				<_Parameter2>$(SourceDirty)</_Parameter2>
			</AssemblyAttribute>
			<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
				<_Parameter1>BuildTimeUtc</_Parameter1>
				<_Parameter2>$([System.DateTime]::UtcNow.ToString("o"))</_Parameter2>
			</AssemblyAttribute>
		</ItemGroup>
	</Target>

</Project>
